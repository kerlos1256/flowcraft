// Flowcraft data model (shared with apps/api). The web app is deployed as a
// Next.js fullstack app on Vercel, so it owns a Prisma client too; migrations
// are managed from apps/api (already applied to the Neon database).

generator client {
  provider      = "prisma-client-js"
  // native = local dev; rhel-openssl-3.0.x = Vercel's Node runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Billing (Stripe). plan is the source of truth for entitlements, kept in sync
  // by the Stripe webhook. Free by default.
  plan                 String    @default("free") // 'free' | 'pro' | 'team'
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  stripeStatus         String?   @map("stripe_status") // active | trialing | past_due | canceled ...
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz(6)

  workflows Workflow[]
  widgets   Widget[]
  aiEdits   AiEdit[]

  memberships     Membership[]
  ownedWorkspaces Workspace[]  @relation("WorkspaceOwner")

  @@map("users")
}

// A shared, multi-member tenant — available only to Team-plan owners. Solo Free/Pro
// accounts never create one; their resources keep workspaceId = null (personal).
model Workspace {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  ownerUserId String   @map("owner_user_id") @db.Uuid
  status      String   @default("active") // active | read_only | suspended
  // Non-expiring top-up balances (mobile-data style): consumed only after the
  // monthly allotment, never reset. Credited by one-time top-up purchases.
  topupRunsBalance    Int      @default(0) @map("topup_runs_balance")
  topupAiTokenBalance Int      @default(0) @map("topup_ai_token_balance")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner       User              @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invites     WorkspaceInvite[]
  seats       WorkspaceSeat[]
  topups      TopupPurchase[]
  workflows   Workflow[]
  widgets     Widget[]
  aiEdits     AiEdit[]

  @@index([ownerUserId])
  @@map("workspaces")
}

// One row per completed top-up purchase — the audit trail behind the balance.
model TopupPurchase {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  kind            String // 'runs' | 'ai_tokens'
  amount          Int
  priceCents      Int      @map("price_cents")
  stripePaymentId String?  @unique @map("stripe_payment_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("topup_purchases")
}

// A seat = one member slot. The 2 `base` seats come with the Team plan; each
// `extra` seat is its OWN $12/mo Stripe subscription (so one failed invoice can
// deactivate exactly one seat). Pre-buy-then-assign: a seat can be paid but
// unassigned, then attached to a membership.
model WorkspaceSeat {
  id                   String   @id @default(uuid()) @db.Uuid
  workspaceId          String   @map("workspace_id") @db.Uuid
  kind                 String   @default("extra") // base | extra
  stripeSubscriptionId String?  @unique @map("stripe_subscription_id")
  status               String   @default("active") // active | past_due | canceled
  assignedMembershipId String?  @unique @map("assigned_membership_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace          Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedMembership Membership? @relation(fields: [assignedMembershipId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("workspace_seats")
}

// A user's identity + permission set within one workspace (the "specific user entity
// per workspace"). permissions is a string[] of permission keys; isOwner is the
// irrevocable billing/superuser. Removing a membership never deletes shared resources.
model Membership {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  isOwner     Boolean  @default(false) @map("is_owner")
  permissions Json     @default("[]")
  status      String   @default("active") // active | deactivated (unpaid seat)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat      WorkspaceSeat?

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

// A pending email invitation. The raw token is emailed / shown as a link; only its
// hash is stored. Carries the permissions the invitee will receive on accept.
model WorkspaceInvite {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  email           String
  permissions     Json     @default("[]")
  tokenHash       String   @unique @map("token_hash")
  invitedByUserId String   @map("invited_by_user_id") @db.Uuid
  status          String   @default("pending") // pending | accepted | revoked | expired
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map("workspace_invites")
}

model Workflow {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid // null = personal; set = shared
  name        String
  graph       Json     @default("{\"nodes\":[],\"edges\":[]}")
  status      String   @default("draft")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      WorkflowRun[]
  widgets   Widget[]
  aiEdits   AiEdit[]

  @@index([userId])
  @@index([workspaceId])
  @@map("workflows")
}

// One row per successful AI assistant edit — the authoritative usage ledger for
// the token quota (Free: 3 lifetime / 1 per workflow; Pro/Team: monthly budget,
// counted per account = workspace). tokenCost is the model's cost (Sonnet 1, Opus 2).
model AiEdit {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid // null = personal; set = workspace pool
  workflowId  String   @map("workflow_id") @db.Uuid
  model       String // 'sonnet' | 'opus'
  tokenCost   Int      @map("token_cost")
  promptChars Int      @map("prompt_chars")
  tokensIn    Int?     @map("tokens_in")
  tokensOut   Int?     @map("tokens_out")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, workflowId])
  @@index([workspaceId, createdAt])
  @@map("ai_edits")
}

model WorkflowRun {
  id           String    @id @default(uuid()) @db.Uuid
  workflowId   String    @map("workflow_id") @db.Uuid
  inngestRunId String?   @map("inngest_run_id")
  status       String    @default("running")
  triggeredBy  String    @map("triggered_by")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)

  workflow Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps    RunStep[]

  @@index([workflowId])
  @@index([startedAt])
  @@map("workflow_runs")
}

model RunStep {
  id          String    @id @default(uuid()) @db.Uuid
  runId       String    @map("run_id") @db.Uuid
  nodeId      String    @map("node_id")
  stepType    String    @map("step_type")
  status      String    @default("pending")
  input       Json      @default("{}")
  output      Json?
  error       String?
  attempts    Int       @default(0)
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeId])
  @@index([runId])
  @@map("run_steps")
}

model NodeTemplate {
  id           String @id @default(uuid()) @db.Uuid
  type         String @unique
  label        String
  configSchema Json   @map("config_schema")

  @@map("node_templates")
}

model Widget {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid // null = personal; set = shared
  workflowId  String   @map("workflow_id") @db.Uuid
  name        String
  type        String // 'form' | 'button' | 'feedback' | 'email_capture' | 'chat'
  placement   String   @default("inline") // 'inline' | 'floating'
  // Renderable config: fields, labels, theme, protection (domain allowlist, turnstile).
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow    Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  submissions WidgetSubmission[]

  @@index([userId])
  @@index([workspaceId])
  @@map("widgets")
}

// One row per public submission — powers rate limiting (per IP / per widget) and
// light analytics. Stores a hashed IP, never the raw address.
model WidgetSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  widgetId  String   @map("widget_id") @db.Uuid
  ipHash    String   @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@index([widgetId, createdAt])
  @@index([ipHash, createdAt])
  @@map("widget_submissions")
}
