# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://flowcraft:flowcraft@localhost:5435/flowcraft?schema=public"

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT="3002"
WEB_ORIGIN="http://localhost:3003"

# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3002"

# ── Inngest ──────────────────────────────────────────────────────────────────
# Local dev uses the Inngest dev server (npx inngest-cli dev) — no keys needed.
# INNGEST_DEV=1 tells the SDK to talk to the local dev server.
INNGEST_DEV="1"
INNGEST_BASE_URL="http://localhost:8288"
# In production these come from Inngest Cloud (never commit real values):
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
