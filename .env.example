# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://flowcraft:flowcraft@localhost:5435/flowcraft?schema=public"

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT="3002"
WEB_ORIGIN="http://localhost:3003"

# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3002"

# ── Inngest ──────────────────────────────────────────────────────────────────
# Local dev uses the Inngest dev server (npx inngest-cli dev) — no keys needed.
# INNGEST_DEV=1 tells the SDK to talk to the local dev server.
INNGEST_DEV="1"
INNGEST_BASE_URL="http://localhost:8288"
# In production these come from Inngest Cloud (never commit real values):
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── AI assistant ─────────────────────────────────────────────────────────────
# Required to enable the plain-language workflow assistant. Without it the panel
# shows a "not enabled" notice and the API returns 503.
ANTHROPIC_API_KEY=""
# Optional model overrides (defaults: claude-sonnet-5 / claude-opus-5).
# AI_MODEL_SONNET="claude-sonnet-5"
# AI_MODEL_OPUS="claude-opus-5"

# ── Workspaces (Team plan) ───────────────────────────────────────────────────
# Public base URL, used to build invite accept links. Falls back to WEB_ORIGIN.
APP_URL="http://localhost:3003"
# Transactional email for invites (Resend). Optional — without it, invites still
# work via a copyable link shown in the UI.
RESEND_API_KEY=""
EMAIL_FROM="Flowcraft <onboarding@resend.dev>"
# Stripe Price id for an extra workspace seat ($12/mo recurring). Each extra seat
# becomes its own subscription (metadata.kind=seat). Required to buy seats.
STRIPE_PRICE_SEAT=""
